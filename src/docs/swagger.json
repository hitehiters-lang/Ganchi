    "basePath": "/",
    "paths": {
        "/api/loaders/getall": {
            "get": {
                "description": "Отправляет всю таблицу с данными о каждом погрузчике",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Погрузчики"
                ],
                "summary": "Получить все погрузчики",
                "operationId": "all_loaders",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Loader"
                            }
                        }
                    }
                }
            }
        },
        "/api/loaders/getimage/{loader_id}": {
            "get": {
                "description": "Отправляет всю таблицу с данными о каждом погрузчике",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "image/jpg",
                    " image/png"
                ],
                "tags": [
                    "Погрузчики"
                ],
                "summary": "Получить все погрузчики",
                "operationId": "loader_image",
                "parameters": [
                    {
                        "type": "string",
                        "example": "1",
                        "description": "ID погрузчика",
                        "name": "loader_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "file"
                        }
                    }
                }
            }
        }
    },
